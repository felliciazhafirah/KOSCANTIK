generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql" // ganti kalau pakai mysql
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  password String
  phone    String
  role     Role

  kos      Kos[]        @relation("OwnerKos")
  reviews  Review[]
  books    Book[]
}

model Kos {
  id             Int      @id @default(autoincrement())
  user_id        Int
  name           String
  address        String
  price_per_month Int
  gender         Gender
  description     String
  owner      User         @relation("OwnerKos", fields: [user_id], references: [id])
  images     KosImage[]
  facilities KosFacility[]
  reviews    Review[]
  books      Book[]
}

model KosImage {
  id     Int    @id @default(autoincrement())
  kos_id Int
  file   String

  kos Kos @relation(fields: [kos_id], references: [id])
}

model KosFacility {
  id     Int    @id @default(autoincrement())
  kos_id Int
  facility String

  kos Kos @relation(fields: [kos_id], references: [id])
}

model Review {
  id      Int    @id @default(autoincrement())
  kos_id  Int
  user_id Int
  comment String

  kos  Kos  @relation(fields: [kos_id], references: [id])
  user User @relation(fields: [user_id], references: [id])
}

model Book {
  id        Int       @id @default(autoincrement())
  kos_id    Int
  user_id   Int
  start_date DateTime
  end_date   DateTime
  status     BookStatus

  kos  Kos  @relation(fields: [kos_id], references: [id])
  user User @relation(fields: [user_id], references: [id])
}

enum Role {
  owner
  society
}

enum Gender {
  male
  female
  all
}

enum BookStatus {
  pending
  accept
  reject
}